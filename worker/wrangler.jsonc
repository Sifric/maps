{
  // Sifric Maps – PMTiles tile server
  "name": "maps",
  "main": "index.js",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "browser": { "binding": "MAP_BROWSER" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "TILES_BUCKET",
      "bucket_name": "mazo-maps"
    }
  ]
}
