{
  // Sifric Maps – PMTiles tile server
  "name": "maps",
  "main": "index.js",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "browser": { "binding": "MAP_BROWSER" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "services": [
    { "binding": "ROUTING_DRIVE", "service": "maps-router-drive" },
    { "binding": "ROUTING_WALK", "service": "maps-router-walk" },
    { "binding": "ROUTING_CYCLE", "service": "maps-router-cycle" },
    { "binding": "ROUTING_MOTORCYCLE", "service": "maps-router-motorcycle" },
    { "binding": "ROUTING_TUK", "service": "maps-router-tuk" },
    { "binding": "ROUTING_DRIVE_NO_TOLLS", "service": "maps-router-drive-no-tolls" },
    { "binding": "ROUTING_DRIVE_NO_HIGHWAYS", "service": "maps-router-drive-no-highways" }
  ],
  "r2_buckets": [
    {
      "binding": "TILES_BUCKET",
      "bucket_name": "mazo-maps"
    }
  ]
}
