{
  // LK Maps – PMTiles tile server
  "name": "maps",
  "main": "index.js",
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "TILES_BUCKET",
      "bucket_name": "mazo-maps"
    }
  ],
  "migrations": [
    { "tag": "v2-delete-live-data-registry", "deleted_classes": ["LiveDataRegistry"] }
  ]
}
