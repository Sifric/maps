{
  "name": "lkmaps-router",
  "main": "index.js",
  "compatibility_date": "2026-11-16",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "containers": [
    {
      "name": "osrm",
      "class_name": "OsrmFallbackContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./Dockerfile"
        }
      },
      "observability": {
        "enabled": true
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "OSRM",
        "class_name": "OsrmFallbackContainer"
      }
    ]
  },
  "exports": {
    "OsrmFallbackContainer": {
      "type": "durable-object",
      "storage": "sqlite",
      "container": "osrm"
    }
  }
}
